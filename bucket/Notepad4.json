            "url": "https://gh-proxy.org/https://github.com/zufuliu/notepad4/releases/download/v26.10r6392/Notepad4_zh-Hans_x64_v26.10r6392.zip",
            "hash": "e36b1fc31f7beb6b1f6eee1c2f9b4f214c3a48c899b64d6d7813569d43e3358e"
        },
        "32bit": {
            "url": "https://gh-proxy.org/https://github.com/zufuliu/notepad4/releases/download/v26.10r6392/Notepad4_i18n_Win32_v26.10r6392.zip",
            "hash": "caa931f22b1773cee7246256e3a7917759f1c6c2817518750662a2b19d12be82"
        },
        "arm64": {
            "url": "https://gh-proxy.org/https://github.com/zufuliu/notepad4/releases/download/v26.10r6392/Notepad4_zh-Hans_ARM64_v26.10r6392.zip",
            "hash": "468d3929085aa750e02a928c65b42ecb0851b7c2da7cb645f1f1d577d0bfaa78"
        }
    },
    "notes": [
        "Add Notepad4 as a context menu option by running:",
        "reg import \"$dir\\install-context.reg\""
    ],
    "bin": "notepad4.exe",
    "shortcuts": [
        [
            "Notepad4.exe",
            "Notepad4"
        ],
        [
            "matepath.exe",
            "matepath"
        ]
    ],
    "post_install": [
        "$dirpath = \"$dir\".Replace('\\', '\\\\')",
        "$exepath = \"$dir\\Notepad4.exe\".Replace('\\', '\\\\')",
        "'install-context', 'uninstall-context' | ForEach-Object {",
        "  if (Test-Path \"$bucketsdir\\$bucket\\scripts\\Notepad4\\$_.reg\") {",
        "    $content = Get-Content \"$bucketsdir\\$bucket\\scripts\\Notepad4\\$_.reg\"",
        "    $content = $content.Replace('$notepaddir', $dirpath)",
        "    $content = $content.Replace('$notepad', $exepath)",
        "    if ($global) {",
        "      $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE')",
        "    }",
        "    $content | Set-Content -Path \"$dir\\$_.reg\" -Encoding Unicode",
        "  }",
        "}"
    ],
    "pre_install": [
        "'Notepad4.ini', 'matepath.ini', 'Notepad4 DarkTheme.ini' | ForEach-Object {",
        "    $persistPath = Join-Path $persist_dir $_",
        "    $defaultPath = Join-Path $dir \"$_-default\"",
        "    $targetPath = Join-Path $dir $_",
        "    if (Test-Path -LiteralPath $persistPath -PathType Container) {",
        "        Remove-Item -LiteralPath $persistPath -Recurse -Force",
        "    }",
        "    if (-not (Test-Path -LiteralPath $persistPath -PathType Leaf) -and (Test-Path -LiteralPath $defaultPath -PathType Leaf)) {",
        "        Copy-Item -LiteralPath $defaultPath -Destination $targetPath",
        "    }",
        "}"
    ],
    "pre_uninstall": [
        "if (Test-Path \"$dir\\uninstall-context.reg\") { reg import \"$dir\\uninstall-context.reg\" }",
        "if (Test-Path \"$dir\\uninstall-associations.reg\") { reg import \"$dir\\uninstall-associations.reg\" }"
    ],
    "persist": [
        "Notepad4.ini",
        "matepath.ini",
        "Notepad4 DarkTheme.ini"
    ],
    "checkver": {
        "github": "https://github.com/zufuliu/notepad4",
        "regex": "([\\d.]+r\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/zufuliu/notepad4/releases/download/v$version/Notepad4_zh-Hans_x64_v$version.zip"
            },
            "32bit": {
                "url": "https://gh-proxy.org/https://github.com/zufuliu/notepad4/releases/download/v$version/Notepad4_i18n_Win32_v$version.zip"
            },
            "arm64": {
                "url": "https://gh-proxy.org/https://github.com/zufuliu/notepad4/releases/download/v$version/Notepad4_zh-Hans_ARM64_v$version.zip"
            }
        }
    }
}
